#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = remove ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper mask andersen-mqtt.service >/dev/null || true
    fi
fi

if [ "$1" = purge ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper purge andersen-mqtt.service >/dev/null || true
        deb-systemd-helper unmask andersen-mqtt.service >/dev/null || true
    fi
fi

exit 0
